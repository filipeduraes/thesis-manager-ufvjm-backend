@startuml thesis_manager_django_compatible
' ============================================================
' Thesis Manager - Modelo Relacional Django-Compatible
' Foco: Compatibilidade com Django + django-allauth + DRF
' PostgreSQL | Arquitetura por Microsserviços
' ============================================================

hide circle
skinparam linetype polyline
skinparam shadowing false
skinparam packageStyle rectangle
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #444444
}
skinparam package {
  BackgroundColor #F7F7F7
  BorderColor #888888
}

' ============================================================
' ENUMS (Podem virar choices no Django ou enums no PostgreSQL)
' ============================================================

package "Enums" #EEEEEE {

  enum profile_role {
    ADMIN
    COORDINATOR
    ADVISOR
    STUDENT
  }

  enum thesis_type {
    MONOGRAPH
    ARTICLE
  }

  enum thesis_status {
    DRAFT
    SUBMITTED
    ADVISOR_REVIEW
    CHANGES_REQUESTED
    ADVISOR_APPROVED
    READY_FOR_DEFENSE
    DEFENSE_SCHEDULED
    UNDER_EVALUATION
    APPROVED
    APPROVED_WITH_REMARKS
    REJECTED
    CORRECTIONS_PENDING
    PUBLISHED
    ARCHIVED
  }

  enum review_decision {
    APPROVED
    CHANGES_REQUESTED
    REJECTED
  }

  enum defense_modality {
    IN_PERSON
    REMOTE
  }

  enum defense_status {
    SCHEDULED
    IN_PROGRESS
    COMPLETED
    CANCELLED
  }

  enum defense_member_role {
    CHAIR
    ADVISOR
    EXAMINER
    EXTERNAL_EXAMINER
    ALTERNATE
  }

  enum availability_status {
    PENDING
    CONFIRMED
    DECLINED
  }

  enum defense_result {
    APPROVED
    APPROVED_WITH_REMARKS
    REJECTED
  }

  enum document_type {
    DEFENSE_MINUTES
    PUBLICATION_AUTHORIZATION
    SPELLING_CHECK_PROOF
    OTHER
  }

  enum document_status {
    PENDING
    SUBMITTED
    VALIDATED
    REJECTED
  }

  enum invitation_status {
    PENDING
    ACCEPTED
    DECLINED
    EXPIRED
    REVOKED
    USED
  }

  enum processing_status {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
    RETRYING
  }

  enum audit_action {
    CREATE
    READ
    UPDATE
    DELETE
    LOGIN
    LOGOUT
    LOGIN_FAILED
    UPLOAD
    DOWNLOAD
    REVIEW
    SCHEDULE
    EVALUATE
    PUBLISH
    INVITE
    TOKEN_ACCESS
    APPROVE
    REJECT
  }

  enum network_origin {
    INSTITUTIONAL_NETWORK
    VPN
    EXTERNAL
  }

  enum notification_channel {
    EMAIL
    IN_APP
  }

  enum notification_status {
    PENDING
    SENT
    DELIVERED
    FAILED
    READ
  }
}

' ============================================================
' 1. AUTENTICAÇÃO (Custom User Model + django-allauth)
' Django nativo: auth_group, auth_permission, auth_user_groups, 
' auth_user_user_permissions, django_session, contenttypes
' NÃO DUPLICAR ESSAS TABELAS
' ============================================================

package "Authentication Service" #E8F4FF {

  entity users_user {
    * id : uuid <<PK>>
    --
    ' Custom User Model herdando de AbstractBaseUser + PermissionsMixin
    * password : varchar(128)
    * last_login : timestamptz
    * is_superuser : boolean = false
    * email : varchar(254) <<UK>>
    * name : varchar(200)
    * is_staff : boolean = false
    * is_active : boolean = true
    * date_joined : timestamptz = now()
    ' email_verified_at removido - gerenciado por account_emailaddress (allauth)
  }

  entity user_profile_role {
    * id : uuid <<PK>>
    --
    * user_id : uuid <<FK>>
    * role : profile_role
    * assigned_by_id : uuid <<FK>>
    * assigned_at : timestamptz = now()
    revoked_at : timestamptz
    ' Mantém mapeamento explícito com perfis do sistema
    ' Grupos do Django (auth_group) podem ser sincronizados com estes papéis
  }

  entity session_audit {
    * id : uuid <<PK>>
    --
    session_key : varchar(40)
    * user_id : uuid <<FK>>
    * ip_address : inet
    user_agent : varchar(512)
    * origin : network_origin
    * login_at : timestamptz = now()
    logout_at : timestamptz
    last_activity_at : timestamptz
    ' NÃO duplica django_session. Apenas audita sessões existentes
  }

  entity external_invitation {
    * id : uuid <<PK>>
    --
    * invited_by_id : uuid <<FK>>
    * name : varchar(200)
    * email : varchar(254)
    * institution : varchar(200)
    * token_hash : bytea(32) <<UK>>
    * status : invitation_status = PENDING
    * expires_at : timestamptz
    used_at : timestamptz
    accepted_at : timestamptz
    declined_at : timestamptz
    revoked_at : timestamptz
    revoked_by_id : uuid <<FK>>
    * created_at : timestamptz = now()
    ' Membro externo temporário - sem conta permanente
  }

  entity audit_log {
    * id : uuid <<PK>>
    --
    actor_user_id : uuid <<FK>>
    actor_external_invitation_id : uuid <<FK>>
    actor_role : profile_role
    * action : audit_action
    * entity_type : varchar(50)
    * entity_id : varchar(100)
    * entity_app_label : varchar(50)
    * origin : network_origin
    ip_address : inet
    user_agent : varchar(512)
    changes : jsonb
    metadata : jsonb
    previous_hash : bytea(32)
    * row_hash : bytea(32)
    * occurred_at : timestamptz = now()
    ' Append-only. Registrado via signals/middleware
  }

  users_user ||--o{ user_profile_role
  users_user |o--o{ user_profile_role : "assigned_by"
  users_user ||--o{ session_audit
  users_user |o--o{ external_invitation : "invited_by"
  users_user |o--o{ external_invitation : "revoked_by"
  users_user |o--o{ audit_log : "actor"
  external_invitation |o--o{ audit_log : "actor_external"
}

' ============================================================
' 2. ACADÊMICO (Perfis complementam o Custom User)
' ============================================================

package "Academic Registry" #E8FFE8 {

  entity department {
    * id : uuid <<PK>>
    --
    * name : varchar(150) <<UK>>
    * acronym : varchar(10) <<UK>>
    * is_active : boolean = true
    * created_at : timestamptz = now()
    * updated_at : timestamptz = now()
  }

  entity course {
    * id : uuid <<PK>>
    --
    * department_id : uuid <<FK>>
    coordinator_id : uuid <<FK>>
    * name : varchar(150)
    * code : varchar(10) <<UK>>
    * is_active : boolean = true
    * created_at : timestamptz = now()
    * updated_at : timestamptz = now()
  }

  entity professor_profile {
    * user_id : uuid <<PK>>
    --
    * department_id : uuid <<FK>>
    * registration_number : varchar(20) <<UK>>
    areas_of_interest : text[]
    lattes_url : varchar(500)
    * is_active : boolean = true
    * created_at : timestamptz = now()
    * updated_at : timestamptz = now()
    ' OneToOne com users_user - dados específicos do docente
  }

  entity student_profile {
    * user_id : uuid <<PK>>
    --
    * course_id : uuid <<FK>>
    * registration_number : varchar(20) <<UK>>
    advisor_id : uuid <<FK>>
    entry_year : smallint
    * is_active : boolean = true
    * created_at : timestamptz = now()
    * updated_at : timestamptz = now()
    ' OneToOne com users_user - dados acadêmicos do aluno
  }

  department ||--o{ course
  department ||--o{ professor_profile
  course ||--o{ student_profile
  users_user ||--o| professor_profile
  users_user ||--o| student_profile
  users_user |o--o{ course : "coordenador"
  users_user |o--o{ student_profile : "orientador"
}

' ============================================================
' 3. MONOGRAFIAS
' ============================================================

package "Thesis Service" #FFF4E8 {

  entity keyword {
    * id : uuid <<PK>>
    --
    * name : varchar(50) <<UK>>
    * normalized_name : varchar(50) <<UK>>
  }

  entity stored_file {
    * id : uuid <<PK>>
    --
    * original_filename : varchar(255)
    * stored_filename : varchar(255) <<UK>>
    * mime_type : varchar(100)
    * extension : varchar(10)
    * size_bytes : bigint
    * sha256 : bytea(32) <<UK>>
    * storage_path : varchar(512)
    * storage_bucket : varchar(100)
    * uploaded_by_id : uuid <<FK>>
    * uploaded_at : timestamptz = now()
    processing_status : processing_status = PENDING
    extracted_text_path : varchar(512)
    extracted_at : timestamptz
    ' Deduplicação por sha256. Suporte a object storage
  }

  entity thesis {
    * id : uuid <<PK>>
    --
    * course_id : uuid <<FK>>
    * advisor_id : uuid <<FK>>
    * type : thesis_type = MONOGRAPH
    * title : varchar(500)
    * abstract : text
    * journal : varchar(200)
    * reference_code : varchar(50) <<UK>>
    * status : thesis_status = DRAFT
    * is_public : boolean = false
    * created_at : timestamptz = now()
    * updated_at : timestamptz = now()
    submitted_at : timestamptz
    advisor_approved_at : timestamptz
    published_at : timestamptz
    deleted_at : timestamptz
    ' Sem campo "student_id" direto - use thesis_author
  }

  entity thesis_author {
    * id : uuid <<PK>>
    --
    * thesis_id : uuid <<FK>>
    * author_id : uuid <<FK>>
    * position : smallint
    * is_main_author : boolean = false
    * created_at : timestamptz = now()
    ' Permite até 5 autores. position 1 = autor principal
  }

  entity thesis_keyword {
    * thesis_id : uuid <<PK,FK>>
    * keyword_id : uuid <<PK,FK>>
  }

  entity thesis_file {
    * id : uuid <<PK>>
    --
    * thesis_id : uuid <<FK>>
    * stored_file_id : uuid <<FK>>
    * version_number : smallint
    * is_current : boolean = false
    * change_description : text
    * uploaded_by_id : uuid <<FK>>
    * uploaded_at : timestamptz = now()
    hash_verified_at : timestamptz
    text_extracted_at : timestamptz
    ' Única versão atual por tese
  }

  entity thesis_review {
    * id : uuid <<PK>>
    --
    * thesis_file_id : uuid <<FK>>
    * reviewer_id : uuid <<FK>>
    * decision : review_decision
    * comments : text
    * recommendations : text
    * reviewed_at : timestamptz = now()
    ip_address : inet
    ' Revisão vinculada à versão específica
  }

  entity thesis_status_history {
    * id : uuid <<PK>>
    --
    * thesis_id : uuid <<FK>>
    * previous_status : thesis_status
    * new_status : thesis_status
    * changed_by_id : uuid <<FK>>
    * reason : text
    * metadata : jsonb
    * changed_at : timestamptz = now()
  }

  entity thesis_document {
    * id : uuid <<PK>>
    --
    * thesis_id : uuid <<FK>>
    * thesis_file_id : uuid <<FK>>
    * stored_file_id : uuid <<FK>>
    * type : document_type
    * status : document_status = PENDING
    * submitted_by_id : uuid <<FK>>
    * validated_by_id : uuid <<FK>>
    * submitted_at : timestamptz = now()
    validated_at : timestamptz
    rejection_reason : text
  }

  course ||--o{ thesis
  users_user ||--o{ thesis : "advisor"
  users_user ||--o{ thesis_author : "autor"
  thesis ||--|{ thesis_author
  thesis ||--o{ thesis_keyword
  keyword ||--o{ thesis_keyword
  users_user ||--o{ stored_file : "uploaded_by"
  thesis ||--o{ thesis_file
  stored_file ||--o{ thesis_file
  thesis_file ||--o{ thesis_review
  users_user ||--o{ thesis_review : "reviewer"
  thesis ||--o{ thesis_status_history
  users_user ||--o{ thesis_status_history : "changed_by"
  thesis ||--o{ thesis_document
  thesis_file |o--o{ thesis_document
  stored_file ||--o{ thesis_document
  users_user |o--o{ thesis_document : "submitted_by"
  users_user |o--o{ thesis_document : "validated_by"
  users_user ||--o{ thesis_file : "uploaded_by"
}

' ============================================================
' 4. BANCAS E AVALIAÇÃO
' ============================================================

package "Defense Service" #FFE8F4 {

  entity defense {
    * id : uuid <<PK>>
    --
    * thesis_id : uuid <<FK>>
    * scheduled_by_id : uuid <<FK>>
    * modality : defense_modality
    * status : defense_status = SCHEDULED
    * starts_at : timestamptz
    * ends_at : timestamptz
    location : varchar(255)
    meeting_url : varchar(500)
    meeting_room : varchar(100)
    result : defense_result
    final_grade : numeric(4,2)
    result_calculated_at : timestamptz
    result_calculated_by_id : uuid <<FK>>
    minutes_file_id : uuid <<FK>>
    * created_at : timestamptz = now()
    * updated_at : timestamptz = now()
    cancelled_at : timestamptz
    cancellation_reason : text
  }

  entity defense_member {
    * id : uuid <<PK>>
    --
    * defense_id : uuid <<FK>>
    user_id : uuid <<FK>>
    external_invitation_id : uuid <<FK>>
    * role : defense_member_role
    * availability : availability_status = PENDING
    invited_at : timestamptz = now()
    responded_at : timestamptz
    confirmed_at : timestamptz
    notified_at : timestamptz
  }

  entity defense_evaluation {
    * id : uuid <<PK>>
    --
    * defense_member_id : uuid <<FK>>
    * grade : numeric(4,2)
    * decision : defense_result
    * feedback : text
    * private_comments : text
    * submitted_at : timestamptz = now()
    ip_address : inet
    * is_locked : boolean = false
  }

  thesis ||--o{ defense
  users_user ||--o{ defense : "scheduled_by"
  users_user |o--o{ defense : "result_calculated_by"
  stored_file |o--o{ defense : "minutes"
  defense ||--|{ defense_member
  users_user |o--o{ defense_member
  external_invitation |o--o| defense_member
  defense_member ||--o{ defense_evaluation
}

' ============================================================
' 5. REPOSITÓRIO PÚBLICO
' ============================================================

package "Repository Service" #F4E8FF {

  entity publication {
    * id : uuid <<PK>>
    --
    * thesis_id : uuid <<FK>>
    * thesis_file_id : uuid <<FK>>
    * published_by_id : uuid <<FK>>
    * slug : varchar(250) <<UK>>
    doi : varchar(100) <<UK>>
    * year : smallint
    * citation_count : integer = 0
    * view_count : integer = 0
    * download_count : integer = 0
    * is_featured : boolean = false
    * published_at : timestamptz = now()
    * updated_at : timestamptz = now()
    integrity_verified_at : timestamptz
    last_indexed_at : timestamptz
    ' Referencia versão imutável
  }

  entity publication_access_log {
    * id : uuid <<PK>>
    --
    * publication_id : uuid <<FK>>
    ip_address : inet
    user_agent : varchar(512)
    referrer : varchar(500)
    * accessed_at : timestamptz = now()
    action : varchar(20)
    ' Analytics sem comprometer performance
  }

  entity repository_search_index {
    * thesis_id : uuid <<PK>>
    --
    * title_tsv : tsvector
    * abstract_tsv : tsvector
    * full_text_tsv : tsvector
    * combined_tsv : tsvector
    keywords_text : text
    authors_text : text
    advisor_text : text
    course_name : varchar(150)
    course_code : varchar(10)
    type : thesis_type
    year : smallint
    defense_date : date
    doi : varchar(100)
    slug : varchar(250)
    tags : text[]
    updated_at : timestamptz = now()
    ' Atualizado via evento assíncrono
  }

  thesis ||--o| publication
  thesis_file ||--o{ publication
  users_user ||--o{ publication : "published_by"
  publication ||--o{ publication_access_log
}

' ============================================================
' 6. FILA DE EVENTOS E NOTIFICAÇÕES
' ============================================================

package "Event Bus & Notification Service" #E8FFFF {

  entity outbox_event {
    * id : uuid <<PK>>
    --
    * aggregate_type : varchar(50)
    * aggregate_id : uuid
    * event_type : varchar(100)
    * event_version : varchar(10) = '1.0'
    * payload : jsonb
    * headers : jsonb
    * status : processing_status = PENDING
    * attempts : integer = 0
    * max_attempts : integer = 10
    correlation_id : uuid
    causation_id : uuid
    * created_at : timestamptz = now()
    ' Agenda a próxima tentativa de publicação (backoff exponencial do publicador)
    * next_attempt_at : timestamptz = now()
    published_at : timestamptz
    failed_at : timestamptz
    last_error : text
  }

  entity processed_event {
    * consumer_group : varchar(100) <<PK>>
    * event_id : uuid <<PK>>
    --
    * processed_at : timestamptz = now()
    processing_time_ms : integer
  }

  entity notification_template {
    * id : uuid <<PK>>
    --
    * code : varchar(50) <<UK>>
    * subject : varchar(200)
    * body_html : text
    * body_text : text
    * variables : jsonb
    * is_active : boolean = true
    * created_at : timestamptz = now()
    * updated_at : timestamptz = now()
  }

  entity notification {
    * id : uuid <<PK>>
    --
    * template_id : uuid <<FK>>
    * event_id : uuid <<FK>>
    user_id : uuid <<FK>>
    external_invitation_id : uuid <<FK>>
    external_email : varchar(254)
    * channel : notification_channel
    * subject : varchar(200)
    * body : text
    * status : notification_status = PENDING
    * attempts : integer = 0
    priority : smallint = 5
    * scheduled_at : timestamptz = now()
    sent_at : timestamptz
    delivered_at : timestamptz
    read_at : timestamptz
    failed_at : timestamptz
    error_message : text
  }

  notification_template ||--o{ notification
  outbox_event |o--o{ notification
  users_user |o--o{ notification
  external_invitation |o--o{ notification
}

' ============================================================
' 7. RELATÓRIOS
' ============================================================

package "Reporting Service" #FFFFE8 {

  entity report_execution {
    * id : uuid <<PK>>
    --
    * executed_by_id : uuid <<FK>>
    report_code : varchar(50)
    parameters : jsonb
    filters : jsonb
    result_data : jsonb
    format : varchar(10)
    file_id : uuid <<FK>>
    * executed_at : timestamptz = now()
    expires_at : timestamptz
  }

  entity dashboard_metric {
    * id : uuid <<PK>>
    --
    metric_key : varchar(50)
    metric_name : varchar(150)
    value : numeric(15,2)
    unit : varchar(20)
    period_start : date
    period_end : date
    course_id : uuid <<FK>>
    department_id : uuid <<FK>>
    * calculated_at : timestamptz = now()
    metadata : jsonb
  }

  users_user ||--o{ report_execution
  stored_file |o--o{ report_execution
  course |o--o{ dashboard_metric
  department |o--o{ dashboard_metric
}

' ============================================================
' NOTAS IMPORTANTES - DJANGO COMPATIBILITY
' ============================================================

note as N_DJANGO
  **Compatibilidade com Django**

  **Tabelas NATIVAS do Django (NÃO criar):**
  - auth_user (substituído por users_user como AUTH_USER_MODEL)
  - auth_group, auth_permission, auth_user_groups, auth_user_user_permissions
  - django_session, django_content_type, django_migrations, django_admin_log

  **django-allauth (NÃO duplicar):**
  - account_emailaddress (gerencia verificação de e-mail)
  - socialaccount_* (se usado futuramente)
  - email_verified_at removido de users_user

  **Padrões Django:**
  - Custom User Model com email como USERNAME_FIELD
  - Herdar de AbstractBaseUser + PermissionsMixin
  - Usar UUIDField como PK (requer desde primeira migração)
  - Grupos do Django para permissões técnicas
  - user_profile_role mapeia perfis de negócio (ADMIN/COORDINATOR/ADVISOR/STUDENT)
  - session_audit complementa django_session (não o substitui)
  - OneToOneField para professor_profile e student_profile
  - ForeignKey sempre para AUTH_USER_MODEL

  **Reduções de redundância:**
  - Removido user_session duplicado (usar django_session + session_audit)
  - Removido email_verified_at (delegado ao allauth)
  - Removido user_role_assignment genérico redundante (user_profile_role mais enxuto)
  - Campos derivados NÃO armazenados (contadores calculados via queries/aggregates)
  - FK nomeadas com *_id padronizado
end note

note as N_RULES
  **Regras de Negócio**

  - stored_file.sha256 UNIQUE + CHECK octet_length = 32
  - Apenas PDF: mime_type IN ('application/pdf')
  - size_bytes <= 52428800 (50MB)
  - thesis_file: UNIQUE(thesis_id, version_number) + apenas 1 is_current
  - thesis_author: position >=1, UNIQUE(thesis_id, position), <= 5 autores
  - Agendamento requer thesis_review APPROVED na versão CURRENT
  - defense_member: exatamente um entre user_id/external_invitation_id
  - defense: CHECK(ends_at > starts_at); UNIQUE parcial por thesis com status SCHEDULED
  - defense_evaluation: grade BETWEEN 0 AND 10; imutável após locked
  - Resultado calculado apenas após todos membros não-suplentes avaliados
  - PUBLICATION_AUTHORIZATION VALIDATED obrigatório p/ publicação
  - thesis PUBLISHED com deleted_at IS NULL mas proteção via trigger (não deletar)
  - external_invitation: token_hash apenas, expiração obrigatória
  - audit_log: INSERT apenas (sem UPDATE/DELETE)
  - repository_search_index atualizado via eventos
end note

N_DJANGO -[hidden]- N_RULES

@enduml
