# Se vazio, o Django gera uma chave efêmera por processo. Defina explicitamente
# em produção para não invalidar sessões a cada reinício.
DJANGO_SECRET_KEY=
# True habilita /api/v1/auth/dev-login (sem Google). Use apenas em ambiente local isolado.
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Portas publicadas pelo Docker Compose. O gateway do perfil "microservices" usa
# uma porta própria porque o serviço "backend" permanece publicado em BACKEND_PORT.
BACKEND_PORT=8000
GATEWAY_PORT=8080
FRONTEND_PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/thesis_manager
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SAMESITE=Lax
# False apenas para desenvolvimento local; habilite em ambientes HTTPS.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax
# False apenas para desenvolvimento local; habilite em ambientes HTTPS.
CSRF_COOKIE_SECURE=False
TRUSTED_PROXY_COUNT=0
INSTITUTIONAL_NETWORK_CIDRS=
VPN_NETWORK_CIDRS=
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128
INSTITUTIONAL_EMAIL_DOMAIN=ufvjm.edu.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EXTERNAL_INVITATION_TOKEN_TTL_HOURS=72
EXTERNAL_SESSION_TTL_MINUTES=240
SESSION_ACTIVITY_UPDATE_INTERVAL_SECONDS=300
SESSION_COOKIE_AGE=28800
# Uploads de monografia (PDF). MEDIA_ROOT não deve ser servido publicamente.
# MEDIA_ROOT=/var/lib/thesis-manager/media
THESIS_MAX_PDF_SIZE_MB=50
THESIS_MAX_DOCUMENT_SIZE_MB=20
THESIS_MAX_KEYWORDS=10
THESIS_MAX_AUTHORS=5
# Tempo de vida (s) do cache Redis da busca pública (chaves busca:<hash>).
PUBLIC_REPOSITORY_CACHE_TTL_SECONDS=300
# E-mail. No Docker Compose estas variáveis são ignoradas: o compose envia tudo ao
# Mailpit local (interface em http://127.0.0.1:8025, SMTP só dentro da rede do Docker).
# Fora do Docker não há caixa local e os envios ficam FAILED (reenvie com
# "consume_notifications --retry-pending" depois de configurar um SMTP).
# PRODUÇÃO: o EMAIL_BACKEND e o SMTP institucional (host, porta, TLS e credenciais) são
# configurados à parte, nas variáveis do ambiente de implantação, nunca neste arquivo.
# Nunca use django.core.mail.backends.console.EmailBackend: ele imprime o e-mail
# inteiro no log, inclusive o token de acesso do membro externo da banca.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@ufvjm.edu.br
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Eventos assíncronos (outbox + RabbitMQ). Credenciais fictícias; troque fora do ambiente local.
# Usuário, senha e vhost criados pelo container rabbitmq do Docker Compose. Use senha
# só com letras, números, "-" ou "_" (ela entra na URL AMQP sem codificação).
RABBITMQ_DEFAULT_USER=thesis_events
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_DEFAULT_VHOST=thesis_manager
# Usada fora do Docker (localhost). No Docker Compose a URL é montada a partir das
# três variáveis acima e aponta para o serviço rabbitmq.
RABBITMQ_URL=amqp://thesis_events:change-me@localhost:5672/thesis_manager
EVENTS_EXCHANGE=thesis.events
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=900
NOTIFICATIONS_QUEUE=notifications.thesis-events
NOTIFICATIONS_PREFETCH=10
INDEXING_QUEUE=indexing.thesis-events
INDEXING_PREFETCH=5
ADJUDICATION_QUEUE=adjudication.thesis-events
ADJUDICATION_PREFETCH=5
REPOSITORY_QUEUE=repository.thesis-events
REPOSITORY_PREFETCH=5
REPORTS_QUEUE=reports.thesis-events
REPORTS_PREFETCH=5
SERVICE_DATABASES_SHARED=True
AUTH_DATABASE_URL=postgresql://user:change-me@localhost:5432/thesis_auth
COMMITTEE_DATABASE_URL=postgresql://user:change-me@localhost:5432/thesis_committee
REPOSITORY_DATABASE_URL=postgresql://user:change-me@localhost:5432/thesis_repository
REPORTS_DATABASE_URL=postgresql://user:change-me@localhost:5432/thesis_reports
NOTIFICATIONS_DATABASE_URL=postgresql://user:change-me@localhost:5432/thesis_notifications
UPLOAD_TRACKING_TTL_SECONDS=3600
UPLOAD_GLOBAL_DAILY_LIMIT=50
# Token da introspecção entre serviços; vazio desativa o endpoint.
SERVICE_TOKEN=
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Apenas estes proxies podem definir X-Forwarded-For (aceita varios CIDRs).
TRUSTED_PROXY_CIDRS=127.0.0.1/32
